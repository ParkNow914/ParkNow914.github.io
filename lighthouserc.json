{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/404.html",
        "http://localhost/lp/agenda/index.html",
        "http://localhost/lp/atendimento/index.html",
        "http://localhost/lp/juridico/index.html",
        "http://localhost/lp/delivery/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "is-on-https",
          "redirects-http",
          "canonical"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/index\\.html$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "color-contrast": "error",
            "unsized-images": "error",
            "image-size-responsive": "warn",
            "uses-responsive-images": "warn",
            "third-party-facades": "off",
            "csp-xss": "off"
          }
        },
        {
          "matchingUrlPattern": ".*/404\\.html$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "color-contrast": "error",
            "csp-xss": "off"
          }
        },
        {
          "matchingUrlPattern": ".*/lp/[a-z]+/index\\.html$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "color-contrast": "error",
            "unsized-images": "error",
            "csp-xss": "off"
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
