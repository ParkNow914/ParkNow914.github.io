{
  "//": "Mesma página, perfil mobile (CPU 4x mais lenta e rede 4G lenta, que é o padrão do Lighthouse). A maioria dos visitantes chega do Instagram, no celular — não faz sentido só medir desktop. Os limiares de performance são menores porque o throttling é agressivo; acessibilidade e SEO continuam iguais, porque não dependem de hardware.",
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/404.html",
        "http://localhost/lp/agenda/index.html",
        "http://localhost/lp/atendimento/index.html",
        "http://localhost/lp/juridico/index.html",
        "http://localhost/lp/delivery/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": [
          "is-on-https",
          "redirects-http",
          "canonical"
        ]
      }
    },
    "assert": {
      "//": "Matriz e nao assertions planas: a pagina 404 nao tem meta description nem canonical e reprovaria em SEO por design. Cobrar SEO dela seria criar um vermelho que nunca vai poder ficar verde.",
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/index\\.html$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.8
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "color-contrast": "error",
            "unsized-images": "error",
            "csp-xss": "off",
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/404\\.html$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.8
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "color-contrast": "error",
            "unsized-images": "error",
            "csp-xss": "off"
          }
        },
        {
          "matchingUrlPattern": ".*/lp/[a-z]+/index\\.html$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.8
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "color-contrast": "error",
            "unsized-images": "error",
            "csp-xss": "off",
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
